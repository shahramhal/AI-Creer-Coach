            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/dashboard/user-growth", "host": ["{{baseUrl}}"], "path": ["admin", "dashboard", "user-growth"] }
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/users?page=1&limit=20",
              "host": ["{{baseUrl}}"],
