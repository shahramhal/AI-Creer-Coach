# Database connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example: postgresql://postgres:password@localhost:5432/ai_career_coach?schema=public
DATABASE_URL=postgresql+asyncpg://postgres:Komron06@db:5432/career_coach

# Server configuration
PORT=3000
NODE_ENV=development
MONGODB_URL=mongodb://admin:admin123@mongodb:27017/career_coach?authSource=admin
REDIS_URL=redis://redis:6379
# JWT Configuration
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
# External Services
# Use http://localhost:8000 when running ml-service locally, http://ml-service:8000 in Docker
ML_SERVICE_URL=http://localhost:8000
# Use http://localhost:8001 when running job-api-service locally, http://job-api-service:8001 in Docker
JOB_API_URL=http://localhost:8001
